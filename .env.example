# Frontend Environment Variables (exposed to browser - must start with VITE_)
VITE_INSTANTDB_APP_ID=your-instantdb-app-id

# Backend Environment Variables (serverless functions only - NOT exposed to browser)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxx
NOTIFICATION_EMAIL=your-email@example.com

# Optional: Custom "from" email (requires verified domain in Resend)
# FROM_EMAIL=Just AFC <notifications@yourdomain.com>
